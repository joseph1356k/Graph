{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{chrome-extension-src,web/public}/**",
      "maxDuration": 60
    },
    "api/android-live-session.js": {
      "maxDuration": 300
    },
    "api/miracle_runtime.py": {
      "includeFiles": "bounded/miracle-ai/**"
    }
  },
  "routes": [
    {
      "src": "/service-worker.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(self)"
      },
      "continue": true
    },
    {
      "src": "/api/android-live-session",
      "dest": "/api/android-live-session"
    },
    {
      "src": "/api/android/live/session",
      "dest": "/api/android-live-session"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://backend.itsmiracleai.com/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-graph-reenvio"
          },
          "args": "$GRAPH_REENVIO_SECRET",
          "env": [
            "GRAPH_REENVIO_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/examples/medical-demo",
      "dest": "/index.html"
    },
    {
      "src": "/miracle",
      "dest": "/miracle/index.html"
    },
    {
      "src": "/miracle/voice-lab",
      "dest": "/miracle/voice.html"
    }
  ]
}
