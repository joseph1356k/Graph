{
  "manifest_version": 3,
  "name": "Miracle",
  "description": "Asistente flotante de Miracle para dictado, voz y workflows sobre tus paginas.",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Miracle",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/extension-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
