{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run audit:readiness)",
      "Bash(npm run build:chrome-extension)",
      "Bash(npm ci)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(node scripts/verify-:*)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash list)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production.local)",
      "Read(./render.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(grep * .env*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-archivo-editado.js\""
          }
        ]
      }
    ]
  }
}
